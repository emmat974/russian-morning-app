{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pronunciation target v1",
  "type": "object",
  "required": [
    "id",
    "locale",
    "kind",
    "text",
    "audio",
    "evaluation"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "word",
        "phrase",
        "sentence"
      ]
    },
    "text": {
      "type": "string"
    },
    "audio": {
      "type": "object"
    },
    "evaluation": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
