{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "course.schema.json",
  "type": "object",
  "required": [
    "id",
    "order",
    "track",
    "level",
    "title",
    "summary",
    "objectives",
    "concepts",
    "notes",
    "examples"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "track": {
      "type": "string"
    },
    "level": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ru",
          "fr"
        ],
        "properties": {
          "ru": {
            "type": "string"
          },
          "fr": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "active",
        "preview",
        "archived"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
